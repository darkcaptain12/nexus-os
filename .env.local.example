# ============================================================
# APEX OS — Local Development Environment
# Copy to .env.local and fill in values
# ============================================================

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=http://localhost:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_ENV=development

# --- AI Providers ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# --- Notifications ---
RESEND_API_KEY=
ONESIGNAL_APP_ID=
ONESIGNAL_API_KEY=

# --- Feature Flags ---
NEXT_PUBLIC_FEATURE_AI=false
NEXT_PUBLIC_FEATURE_TRADING=false
NEXT_PUBLIC_FEATURE_SHOPIFY=false
NEXT_PUBLIC_FEATURE_DESKTOP_AGENT=false
NEXT_PUBLIC_FEATURE_MEMORY=false
NEXT_PUBLIC_FEATURE_VOICE=false
NEXT_PUBLIC_FEATURE_AUTOMATION=false
NEXT_PUBLIC_FEATURE_NOTIFICATIONS=false
NEXT_PUBLIC_FEATURE_BROWSER_EXTENSION=false
NEXT_PUBLIC_FEATURE_MOBILE=false

# --- Logging ---
LOG_LEVEL=debug
