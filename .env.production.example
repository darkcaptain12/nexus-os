# ============================================================
# APEX OS — Production Environment
# Set these in Vercel Environment Variables, NOT in files
# ============================================================

# --- Supabase (Production Project) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- App ---
NEXT_PUBLIC_APP_URL=
NEXT_PUBLIC_APP_ENV=production

# --- AI Providers ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- Notifications ---
RESEND_API_KEY=
ONESIGNAL_APP_ID=
ONESIGNAL_API_KEY=

# --- Logging ---
LOG_LEVEL=warn
